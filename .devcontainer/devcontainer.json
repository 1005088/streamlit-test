{
  "name": "Terra Atlas Dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
        "openFiles": [
          "README.md",
          "streamlit_app.py"
        ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "pip install --user -r requirements.txt",
  "postAttachCommand": {
    "server": "streamlit run streamlit_app.py --server.address 0.0.0.0 --server.port 8501"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}