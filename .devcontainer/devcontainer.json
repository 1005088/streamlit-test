{
  "name": "Terra Atlas Dashboard",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "customizations": {
    "codespaces": {
        "openFiles": [
          "README.md",
          "app/page.js"
        ]
    },
    "vscode": {
      "settings": {},
      "extensions": []
    }
  },
  "postCreateCommand": "npm ci",
  "postAttachCommand": {
    "server": "npm run dev -- --hostname 0.0.0.0"
  },
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    3000
  ]
}